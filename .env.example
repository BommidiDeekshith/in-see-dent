OPENAI_API_KEY=
JWT_SECRET=your-secret-key-change-in-production-minimum-32-characters-long
KAFKA_BOOTSTRAP=localhost:9092
AI_SERVICE_URL=http://localhost:8090

# AI / LLM (ai-service)
# LLM_MODE=mock     — rule-based RCA (default, no GPU, works offline)
# LLM_MODE=ollama   — local offline LLM via Ollama
# LLM_MODE=openai   — cloud OpenAI API
LLM_MODE=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_MODEL=gpt-4o-mini
